{
  "name": "hardhat-boilerplate",
  "description": "Just Boilerplate",
  "version": "1.0.1",
  "packageManager": "pnpm@10.2.0",
  "main": ".eslintrc.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "accounts": "hardhat accounts",
    "rename-contract": "hardhat rename-contract",
    "compile": "hardhat compile --force",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck",
    "test": "hardhat test",
    "test:scripts": "hardhat test test/scripts-config.ts",
    "test-extended": "EXTENDED_TESTS=1 hardhat test",
    "test-gas": "REPORT_GAS=1 hardhat test",
    "local-node": "hardhat node",
    "deploy:contract": "hardhat run scripts/0_deploy.ts",
    "deploy:localhost": "hardhat run scripts/0_deploy.ts --network localhost",
    "verify": "hardhat run scripts/1_verify.ts"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.6",
    "@openzeppelin/contracts": "^5.0.2",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.12",
    "chai": "4.4.1",
    "ethers": "^6.13.7",
    "hardhat": "^2.22.4",
    "hardhat-gas-reporter": "^2.1.1",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.3.11",
    "solady": "^0.1.26",
    "solidity-coverage": "^0.8.12",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-verify": "^2.0.13",
    "@types/chai-as-promised": "^7.1.8",
    "chai-as-promised": "^7.1.2",
    "dotenv": "^16.4.5"
  },
  "resolutions": {
    "elliptic": "^6.6.1",
    "ws": "^8.17.1",
    "cookie": "^0.7.0"
  }
}
