{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "declaration": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": [
      "ES2020",
      "dom",
      "dom.iterable"
    ]
  },
  "include": [
    "./src",
    "./config",
    "./lib",
    "./scripts",
    "./test",
    "./typechain-types/common.ts",
    "./typechain-types/contracts"
  ],
  "files": ["./hardhat.config.ts"]
}
